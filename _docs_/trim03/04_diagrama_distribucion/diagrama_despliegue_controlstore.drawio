="1" parent="movil_box"><mxGeometry y="59" width="478" height="1" as="geometry"/></mxCell><mxCell id="movil_s1" value="&lt;b&gt;&lt;i&gt;«artifact»&lt;/i&gt; Artefactos&lt;/b&gt;&lt;br&gt;control_store.apk (instalado en el dispositivo)" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=0;overflow=hidden;rotatable=0;points=[];whiteSpace=wrap;html=1;fontSize=11;fontColor=#000000;" vertex="1" parent="movil_box"><mxGeometry y="64" width="478" height="35" as="geometry"/></mxCell><mxCell id="movil_l1" value="" style="line;strokeWidth=1;fillColor=none;align=left;verticalAlign=middle;rotatable=0;labelPosition=right;points=[];strokeColor=#000000;" vertex="1" parent="movil_box"><mxGeometry y="102" width="478" height="1" as="geometry"/></mxCell><mxCell id="movil_s2" value="&lt;b&gt;Hardware - CPU / RAM / DD&lt;/b&gt;&lt;br&gt;Mínimo: Procesador Quad-Core 1.5 GHz - 2 GB RAM - 100 MB libres&lt;br&gt;Ideal: Procesador Octa-Core 2.0 GHz - 4 GB RAM - 500 MB libres" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=0;overflow=hidden;rotatable=0;points=[];whiteSpace=wrap;html=1;fontSize=11;fontColor=#000000;" vertex="1" parent="movil_box"><mxGeometry y="107" width="478" height="50" as="geometry"/></mxCell><mxCell id="twilio" value="&lt;span style=&quot;font-size:11px&quot;&gt;«externo»&lt;/span&gt;&lt;br&gt;&lt;b&gt;SERVICIO EXTERNO - TWILIO&lt;/b&gt;" style="verticalAlign=top;align=left;spacingTop=6;spacingLeft=4;spacingRight=12;shape=cube;size=12;direction=south;fontSize=14;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="1400" y="525" width="360" height="132" as="geometry"/></mxCell><mxCell id="twilio_box" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="1416" y="579" width="318" height="62" as="geometry"/></mxCell><mxCell id="twilio_s0" value="&lt;b&gt;Software - Mensajería&lt;/b&gt;&lt;br&gt;Twilio API for WhatsApp&lt;br&gt;Envía y recibe los mensajes del ChatBot" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=0;overflow=hidden;rotatable=0;points=[];whiteSpace=wrap;html=1;fontSize=11;fontColor=#000000;" vertex="1" parent="twilio_box"><mxGeometry y="6" width="318" height="50" as="geometry"/></mxCell><mxCell id="p1" value="«HTTPS»&lt;br&gt;TLS 1.3 - Puerto 443" style="endArrow=none;startArrow=none;html=1;rounded=0;strokeColor=#000000;strokeWidth=1.5;fontSize=11;fontColor=#000000;labelBackgroundColor=#FFFFFF;verticalAlign=middle;align=center;" edge="1" parent="1" source="clientepc" target="frontend"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p2" value="«HTTPS»&lt;br&gt;REST / JSON - Puerto 443" style="endArrow=none;startArrow=none;html=1;rounded=0;strokeColor=#000000;strokeWidth=1.5;fontSize=11;fontColor=#000000;labelBackgroundColor=#FFFFFF;verticalAlign=middle;align=center;" edge="1" parent="1" source="frontend" target="backend"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p3" value="«HTTPS»&lt;br&gt;REST / JSON - Puerto 443" style="endArrow=none;startArrow=none;html=1;rounded=0;strokeColor=#000000;strokeWidth=1.5;fontSize=11;fontColor=#000000;labelBackgroundColor=#FFFFFF;verticalAlign=middle;align=center;" edge="1" parent="1" source="movil" target="backend"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p4" value="«TCP/IP»&lt;br&gt;Protocolo MySQL - Puerto 3306" style="endArrow=none;startArrow=none;html=1;rounded=0;strokeColor=#000000;strokeWidth=1.5;fontSize=11;fontColor=#000000;labelBackgroundColor=#FFFFFF;verticalAlign=middle;align=center;" edge="1" parent="1" source="backend" target="db"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p5" value="«HTTPS»&lt;br&gt;Webhook / API - Puerto 443" style="endArrow=none;startArrow=none;html=1;rounded=0;strokeColor=#000000;strokeWidth=1.5;fontSize=11;fontColor=#000000;labelBackgroundColor=#FFFFFF;verticalAlign=middle;align=center;" edge="1" parent="1" source="twilio" target="backend"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="nota_front" value="&lt;b&gt;Nota:&lt;/b&gt; El frontend solo sirve archivos estáticos (HTML, CSS, JS e imágenes)." style="shape=note;size=14;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;spacingRight=6;fontSize=11;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="1400" y="60" width="340" height="52" as="geometry"/></mxCell><mxCell id="n6" value="" style="edgeStyle=none;html=1;dashed=1;endArrow=none;startArrow=none;strokeColor=#000000;strokeWidth=1;" edge="1" parent="1" source="nota_front" target="frontend"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="nota_back" value="&lt;b&gt;Nota:&lt;/b&gt; El backend es el único nodo autorizado para conectarse a la base de datos." style="shape=note;size=14;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;spacingRight=6;fontSize=11;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="1400" y="427" width="340" height="52" as="geometry"/></mxCell><mxCell id="n7" value="" style="edgeStyle=none;html=1;dashed=1;endArrow=none;startArrow=none;strokeColor=#000000;strokeWidth=1;" edge="1" parent="1" source="nota_back" target="backend"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="nota_twilio" value="&lt;b&gt;Nota:&lt;/b&gt; Servicio de terceros. El token de Twilio se guarda solo en el backend, nunca en el navegador." style="shape=note;size=14;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;spacingRight=6;fontSize=11;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="1400" y="693" width="360" height="66" as="geometry"/></mxCell><mxCell id="n8" value="" style="edgeStyle=none;html=1;dashed=1;endArrow=none;startArrow=none;strokeColor=#000000;strokeWidth=1;" edge="1" parent="1" source="nota_twilio" target="twilio"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="nota_db" value="&lt;b&gt;Nota:&lt;/b&gt; Respaldo diario automatizado con mysqldump." style="shape=note;size=14;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;spacingRight=6;fontSize=11;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="1400" y="917" width="340" height="40" as="geometry"/></mxCell><mxCell id="n9" value="" style="edgeStyle=none;html=1;dashed=1;endArrow=none;startArrow=none;strokeColor=#000000;strokeWidth=1;" edge="1" parent="1" source="nota_db" target="db"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="nota_movil" value="&lt;b&gt;Nota:&lt;/b&gt; Fase futura: la aplicación móvil no hace parte de la entrega actual." style="shape=note;size=14;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;spacingRight=6;fontSize=11;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="40" y="743" width="480" height="40" as="geometry"/></mxCell><mxCell id="n10" value="" style="edgeStyle=none;html=1;dashed=1;endArrow=none;startArrow=none;strokeColor=#000000;strokeWidth=1;" edge="1" parent="1" source="nota_movil" target="movil"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="titulo" value="&lt;b style=&quot;font-size:15px&quot;&gt;Diagrama de despliegue - Control Store | Autoservicio Ayuelal&lt;/b&gt;&lt;br&gt;Notación UML 2.4.1: caja 3D = nodo («device») | rectángulo dentro del nodo = software, artefactos «artifact» y hardware desplegados en él | línea continua = ruta de comunicación («protocolo») | hoja con esquina doblada = nota" style="text;html=1;align=left;verticalAlign=top;fontSize=12;fontColor=#000000;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="1186" width="1700" height="50" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>