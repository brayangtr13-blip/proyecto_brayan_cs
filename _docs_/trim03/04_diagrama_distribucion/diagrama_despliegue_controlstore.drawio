<mxfile host="app.diagrams.net"><diagram name="Diagrama de despliegue" id="controlstore-despliegue"><mxGraphModel dx="1400" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1276" math="0" shadow="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="frontend" value="&lt;span style=&quot;font-size:11px&quot;&gt;«device»&lt;/span&gt;&lt;br&gt;&lt;b&gt;APP SERVICE FRONTEND&lt;/b&gt;" style="verticalAlign=top;align=left;spacingTop=6;spacingLeft=4;spacingRight=12;shape=cube;size=12;direction=south;fontSize=14;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="710" y="40" width="520" height="265" as="geometry"/></mxCell><mxCell id="frontend_box" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="726" y="94" width="478" height="195" as="geometry"/></mxCell><mxCell id="frontend_s0" value="&lt;b&gt;Software - Interfaz web&lt;/b&gt;&lt;br&gt;HTML5 + CSS3 + JavaScript ES6&lt;br&gt;Bootstrap 5.3.3 + Bootstrap Icons 1.11.3&lt;br&gt;Servidor web: Nginx 1.24 (archivos estáticos)" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=0;overflow=hidden;rotatable=0;points=[];whiteSpace=wrap;html=1;fontSize=11;fontColor=#000000;" vertex="1" parent="frontend_box"><mxGeometry y="6" width="478" height="66" as="geometry"/></mxCell><mxCell id="frontend_l0" value="" style="line;strokeWidth=1;fillColor=none;align=left;verticalAlign=middle;rotatable=0;labelPosition=right;points=[];strokeColor=#000000;" vertex="1" parent="frontend_box"><mxGeometry y="75" width="478" height="1" as="geometry"/></mxCell><mxCell id="frontend_s1" value="&lt;b&gt;&lt;i&gt;«artifact»&lt;/i&gt; Artefactos&lt;/b&gt;&lt;br&gt;index.html - /pages - /assets (css, js, img, fonts)" style="text;strokeColor=n