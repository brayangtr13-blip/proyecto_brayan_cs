xitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="Usuario" target="Rol"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="lb104" value="0..*" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=11;fontColor=#000000;labelBackgroundColor=#FFFFFF;" vertex="1" connectable="0" parent="e103"><mxGeometry x="-0.75" y="-12" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell><mxCell id="lb105" value="1" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=11;fontColor=#000000;labelBackgroundColor=#FFFFFF;" vertex="1" connectable="0" parent="e103"><mxGeometry x="0.75" y="-12" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell><mxCell id="e106" value="" style="html=1;rounded=0;startArrow=none;strokeColor=#000000;strokeWidth=1;fontSize=11;fontColor=#000000;endArrow=block;endFill=0;endSize=14;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="RolAdministrador" target="Rol"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="660" y="1340"/><mxPoint x="1100" y="1340"/></Array></mxGeometry></mxCell><mxCell id="e107" value="" style="html=1;rounded=0;startArrow=none;strokeColor=#000000;strokeWidth=1;fontSize=11;fontColor=#000000;endArrow=block;endFill=0;endSize=14;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="RolCajero" target="Rol"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1100" y="1340"/><mxPoint x="1100" y="1340"/></Array></mxGeometry></mxCell><mxCell id="e108" value="" style="html=1;rounded=0;startArrow=none;strokeColor=#000000;strokeWidth=1;fontSize=11;fontColor=#000000;endArrow=block;endFill=0;endSize=14;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="RolDomiciliario" target="Rol"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1540" y="1340"/><mxPoint x="1100" y="1340"/></Array></mxGeometry></mxCell><mxCell id="leyenda" value="&lt;b&gt;Class diagram (OOP) - Control Store | Autoservicio Ayuelal&lt;/b&gt;&lt;br&gt;17 classes (1 abstract) - 3 enumerations - 17 associations (one per database foreign key) - 3 generalizations&lt;br&gt;Notation: - private | + public | {id} identifier (primary key in the database) | /attribute = derived (computed column) | &lt;i&gt;italics&lt;/i&gt; = abstract | filled diamond = composition | hollow diamond = aggregation | hollow triangle = inheritance | open arrow = navigability&lt;br&gt;Multiplicity: 1 = exactly one | 0..1 = zero or one | 0..* = zero or many | 1..* = one or many | Strategy pattern: User delegates its permissions to its Role (composition over inheritance); changing role = changing usuarios.id_rol" style="text;html=1;align=left;verticalAlign=top;fontSize=12;fontColor=#000000;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="1560" width="2120" height="80" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>