"0" relative="1"><mxPoint x="0" y="-10" as="offset" /></mxGeometry></mxCell><mxCell id="e128" value="" style="html=1;rounded=0;startArrow=none;strokeColor=#000000;strokeWidth=1;fontSize=11;fontColor=#000000;endArrow=open;endFill=0;endSize=10;dashed=1;exitX=0.8;exitY=1;exitDx=0;exitDy=0;entryX=0.8;entryY=0;entryDx=0;entryDy=0;" parent="1" edge="1" source="Delivery" target="DeliveryStatus"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="m129" value="«use»" style="edgeLabel;resizable=0;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#000000;labelBackgroundColor=#FFFFFF;" parent="e128" vertex="1" connectable="0"><mxGeometry as="geometry" x="0" relative="1"><mxPoint x="6" y="0" as="offset" /></mxGeometry></mxCell><mxCell id="leyenda" value="&lt;b&gt;Class Diagram (OOP) - Control Store | Autoservicio Ayuelal&lt;/b&gt;&lt;br&gt;17 classes - 3 enumerations - 23 associations (one per foreign key in the database; the two keys of rol_permiso form the many-to-many association Role - Permission) - 3 «use» dependencies to the enumerations&lt;br&gt;UML 2.4.1 notation: - private | + public | {id} identifier (primary key in the database) | /attribute = derived (computed column) | filled diamond = composition | hollow diamond = aggregation | open arrow = navigability | line without arrows = many-to-many association | dashed «use» line = dependency (the class uses the enumeration as an attribute type)&lt;br&gt;Multiplicity: 1 = one | 0..1 = zero or one | 0..* = zero or many | 1..* = one or many | Each user's permissions come from their Role (User.hasPermission delegates to Role.hasPermission)" style="text;html=1;align=left;verticalAlign=top;fontSize=12;fontColor=#000000;whiteSpace=wrap;" parent="1" vertex="1"><mxGeometry as="geometry" x="40" y="1439" width="2560" height="80" /></mxCell></root></mxGraphModel></diagram></mxfile>