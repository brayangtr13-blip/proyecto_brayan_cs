rrow=open;endFill=0;endSize=10;dashed=1;exitX=0.8;exitY=1;exitDx=0;exitDy=0;entryX=0.8;entryY=0;entryDx=0;entryDy=0;" parent="1" edge="1" source="Delivery" target="DeliveryStatus"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="m157" value="«use»" style="edgeLabel;resizable=0;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#000000;labelBackgroundColor=none;" parent="e156" vertex="1" connectable="0"><mxGeometry as="geometry" x="0" relative="1"><mxPoint x="6" y="0" as="offset" /></mxGeometry></mxCell><mxCell id="e158" value="" style="html=1;rounded=0;startArrow=none;strokeColor=#000000;strokeWidth=1;fontSize=11;fontColor=#000000;jumpStyle=arc;jumpSize=12;endArrow=open;endFill=0;endSize=10;dashed=1;exitX=0;exitY=0.25;exitDx=0;exitDy=0;entryX=1;entryY=0.2321;entryDx=0;entryDy=0;" parent="1" edge="1" source="ChatbotSession" target="Sale"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="m159" value="«create»" style="edgeLabel;resizable=0;html=1;align=center;verticalAlign=middle;fontSize=11;fontColor=#000000;labelBackgroundColor=none;" parent="e158" vertex="1" connectable="0"><mxGeometry as="geometry" x="0" relative="1"><mxPoint x="0" y="-10" as="offset" /></mxGeometry></mxCell><mxCell id="ancla_roles" value="" style="edgeStyle=none;html=1;dashed=1;endArrow=none;startArrow=none;strokeColor=#000000;exitX=0;exitY=0.3;exitDx=0;exitDy=0;entryX=1;entryY=0.3;entryDx=0;entryDy=0;" parent="1" edge="1" source="nota_roles" target="Role"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="leyenda" value="&lt;b&gt;Class Diagram (OOP) - Control Store | Autoservicio Ayuelal&lt;/b&gt;&lt;br&gt;22 classes (18 entity classes, one per table; abstract Person; 3 Role subclasses) - 3 enumerations - 5 packages, one per module - 24 relationships, one per foreign key (19 associations, 3 compositions, 2 aggregations) - 5 generalizations - 4 dependencies (3 «use», 1 «create»)&lt;br&gt;UML 2.4.1 notation: - private | + public | # protected | {id} identifier (primary key) | /attribute = derived (computed column) | italic {abstract} = abstract class | hollow triangle = inheritance | filled diamond = composition | hollow diamond = aggregation | open arrow = navigability | dashed line = dependency | folder = package (module)&lt;br&gt;Multiplicity: 1 = one | 0..1 = zero or one | 0..* = zero or many | 1..* = one or many | Polymorphism: each Role subclass redefines homePanel(); permissions come from RolePermission" style="text;html=1;align=left;verticalAlign=top;fontSize=12;fontColor=#000000;whiteSpace=wrap;" parent="1" vertex="1"><mxGeometry as="geometry" x="50" y="1643" width="2600" height="100" /></mxCell></root></mxGraphModel></diagram></mxfile>