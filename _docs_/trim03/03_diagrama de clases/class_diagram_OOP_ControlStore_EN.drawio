;rounded=0;startArrow=none;strokeColor=#000000;strokeWidth=1;fontSize=11;fontColor=#000000;jumpStyle=arc;jumpSize=12;endArrow=open;endFill=0;endSize=10;dashed=1;exitX=0;exitY=0.959;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" parent="1" edge="1" source="Sale" target="SaleStatus"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="m162" value="«use»" style="edgeLabel;resizable=0;html=1;align=center;verticalAlign=middle;fontSize=11;fontColor=#000000;labelBackgroundColor=none;" parent="e161" vertex="1" connectable="0"><mxGeometry as="geometry" x="0" relative="1"><mxPoint x="0" y="-10" as="offset" /></mxGeometry></mxCell><mxCell id="e163" value="" style="html=1;rounded=0;startArrow=none;strokeColor=#000000;strokeWidth=1;fontSize=11;fontColor=#000000;jumpStyle=arc;jumpSize=12;endArrow=open;endFill=0;endSize=10;dashed=1;exitX=0.8;exitY=1;exitDx=0;exitDy=0;entryX=0.8;entryY=0;entryDx=0;entryDy=0;" parent="1" edge="1" source="Delivery" target="DeliveryStatus"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="m164" value="«use»" style="edgeLabel;resizable=0;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#000000;labelBackgroundColor=none;" parent="e163" vertex="1" connectable="0"><mxGeometry as="geometry" x="0" relative="1"><mxPoint x="6" y="0" as="offset" /></mxGeometry></mxCell><mxCell id="e165" value="" style="html=1;rounded=0;startArrow=none;strokeColor=#000000;strokeWidth=1;fontSize=11;fontColor=#000000;jumpStyle=arc;jumpSize=12;endArrow=open;endFill=0;endSize=10;dashed=1;exitX=0;exitY=0.25;exitDx=0;exitDy=0;entryX=1;entryY=0.2321;entryDx=0;entryDy=0;" parent="1" edge="1" source="ChatbotSession" target="Sale"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="m166" value="«create»" style="edgeLabel;resizable=0;html=1;align=center;verticalAlign=middle;fontSize=11;fontColor=#000000;labelBackgroundColor=none;" parent="e165" vertex="1" connectable="0"><mxGeometry as="geometry" x="0" relative="1"><mxPoint x="0" y="-10" as="offset" /></mxGeometry></mxCell><mxCell id="restriccion_admin" value="{a single administrator; cannot be deleted or deactivated}" style="text;html=1;align=left;verticalAlign=bottom;fontSize=11;fontStyle=2;fontColor=#000000;whiteSpace=wrap;" parent="1" vertex="1"><mxGeometry as="geometry" x="50" y="1480" width="420" height="40" /></mxCell><mxCell id="ancla_roles" value="" style="edgeStyle=none;html=1;dashed=1;endArrow=none;startArrow=none;strokeColor=#000000;exitX=0;exitY=0.3;exitDx=0;exitDy=0;entryX=1;entryY=0.3;entryDx=0;entryDy=0;" parent="1" edge="1" source="nota_roles" target="Role"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="leyenda" value="&lt;b&gt;Class Diagram (OOP) - Control Store | Autoservicio Ayuelal&lt;/b&gt;&lt;br&gt;23 classes (18 entity classes, one per table; abstract Person; 3 Role subclasses; Store) - 3 enumerations - 24 relationships, one per foreign key, plus 3 between the store and its roles (19 associations, 4 compositions, 4 aggregations) - 5 generalizations - 4 dependencies (3 «use», 1 «create»)&lt;br&gt;UML 2.4.1 notation: - private | + public | # protected | {id} identifier (primary key) | /attribute = derived (computed column) | italic {abstract} = abstract class | hollow triangle = inheritance | filled diamond = composition | hollow diamond = aggregation | open arrow = navigability | dashed line = dependency | {text} = constraint&lt;br&gt;Multiplicity: 1 = one | 0..1 = zero or one | 0..* = zero or many | 1..* = one or many | Polymorphism: each Role subclass redefines homePanel(); permissions come from RolePermission | Store is composed of a mandatory administrator and aggregates the cashier and courier roles" style="text;html=1;align=left;verticalAlign=top;fontSize=12;fontColor=#000000;whiteSpace=wrap;" parent="1" vertex="1"><mxGeometry as="geometry" x="50" y="1769" width="2600" height="100" /></mxCell></root></mxGraphModel></diagram></mxfile>