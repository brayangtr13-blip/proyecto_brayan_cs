e="1" /></mxCell><mxCell id="m166" value="«create»" style="edgeLabel;resizable=0;html=1;align=center;verticalAlign=middle;fontSize=11;fontColor=#000000;labelBackgroundColor=none;" parent="e165" vertex="1" connectable="0"><mxGeometry as="geometry" x="0" relative="1"><mxPoint x="0" y="-10" as="offset" /></mxGeometry></mxCell><mxCell id="restriccion_admin" value="{un solo administrador; no se puede eliminar ni inactivar}" style="text;html=1;align=left;verticalAlign=bottom;fontSize=11;fontStyle=2;fontColor=#000000;whiteSpace=wrap;" parent="1" vertex="1"><mxGeometry as="geometry" x="50" y="1480" width="420" height="40" /></mxCell><mxCell id="ancla_roles" value="" style="edgeStyle=none;html=1;dashed=1;endArrow=none;startArrow=none;strokeColor=#000000;exitX=0;exitY=0.3;exitDx=0;exitDy=0;entryX=1;entryY=0.3;entryDx=0;entryDy=0;" parent="1" edge="1" source="nota_roles" target="Rol"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="leyenda" value="&lt;b&gt;Diagrama de clases (POO) - Control Store | Autoservicio Ayuelal&lt;/b&gt;&lt;br&gt;23 clases (18 de entidad, una por tabla; Persona abstracta; 3 subclases de Rol; Autoservicio) - 3 enumeraciones - 24 relaciones, una por llave foránea, más 3 del sistema con sus roles (19 asociaciones, 4 composiciones, 4 agregaciones) - 5 generalizaciones - 4 dependencias (3 «use», 1 «create»)&lt;br&gt;Notación UML 2.4.1: - privado | + público | # protegido | {id} identificador (llave primaria) | /atributo = derivado (columna calculada) | cursiva {abstract} = clase abstracta | triángulo vacío = herencia | rombo relleno = composición | rombo vacío = agregación | flecha abierta = navegabilidad | línea punteada = dependencia | {texto} = restricción&lt;br&gt;Cardinalidad: 1 = uno | 0..1 = cero o uno | 0..* = cero o muchos | 1..* = uno o muchos | Polimorfismo: cada subclase de Rol redefine panelInicio(); los permisos salen de RolPermiso | Autoservicio se compone de un administrador obligatorio y agrega los roles cajero y domiciliario" style="text;html=1;align=left;verticalAlign=top;fontSize=12;fontColor=#000000;whiteSpace=wrap;" parent="1" vertex="1"><mxGeometry as="geometry" x="50" y="1769" width="2600" height="100" /></mxCell></root></mxGraphModel></diagram></mxfile>