itY=0;exitDx=0;exitDy=0;entryX=0.75;entryY=0;entryDx=0;entryDy=0;" parent="1" edge="1" source="SesionChatbot" target="Barrio"><mxGeometry as="geometry" relative="1"><Array as="points"><mxPoint x="1540.0" y="25" /><mxPoint x="2510.0" y="25" /></Array></mxGeometry></mxCell><mxCell id="m122" value="0..*" style="edgeLabel;resizable=0;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#000000;labelBackgroundColor=#FFFFFF;" parent="e121" vertex="1" connectable="0"><mxGeometry as="geometry" x="-0.964" relative="1"><mxPoint x="6" y="0" as="offset" /></mxGeometry></mxCell><mxCell id="m123" value="0..1 barrioTemp" style="edgeLabel;resizable=0;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#000000;labelBackgroundColor=#FFFFFF;" parent="e121" vertex="1" connectable="0"><mxGeometry as="geometry" x="0.964" relative="1"><mxPoint x="6" y="0" as="offset" /></mxGeometry></mxCell><mxCell id="leyenda" value="&lt;b&gt;Diagrama de clases (POO) - Control Store | Autoservicio Ayuelal&lt;/b&gt;&lt;br&gt;17 clases - 3 enumeraciones - 23 asociaciones (una por cada llave foránea de la BD; las dos llaves de rol_permiso forman la asociación muchos a muchos Rol - Permiso)&lt;br&gt;Notación UML 2.4.1: - privado | + público | {id} identificador (llave primaria en la BD) | /atributo = derivado (columna calculada) | rombo relleno = composición | rombo vacío = agregación | flecha abierta = navegabilidad | línea sin flechas = asociación muchos a muchos&lt;br&gt;Cardinalidad: 1 = uno | 0..1 = cero o uno | 0..* = cero o muchos | 1..* = uno o muchos | Los permisos de cada usuario salen de su Rol (Usuario.tienePermiso delega en Rol.tienePermiso)" style="text;html=1;align=left;verticalAlign=top;fontSize=12;fontColor=#000000;whiteSpace=wrap;" parent="1" vertex="1"><mxGeometry as="geometry" x="40" y="1403" width="2560" height="80" /></mxCell></root></mxGraphModel></diagram></mxfile>