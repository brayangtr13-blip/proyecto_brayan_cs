ded=0;startArrow=none;strokeColor=#000000;strokeWidth=1;fontSize=11;fontColor=#000000;endArrow=block;endFill=0;endSize=14;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="RolDomiciliario" target="Rol"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1540" y="1340"/><mxPoint x="1100" y="1340"/></Array></mxGeometry></mxCell><mxCell id="leyenda" value="&lt;b&gt;Diagrama de clases (POO) - Control Store | Autoservicio Ayuelal&lt;/b&gt;&lt;br&gt;17 clases (1 abstracta) - 3 enumeraciones - 17 asociaciones (una por cada llave foránea de la BD) - 3 generalizaciones&lt;br&gt;Notación: - privado | + público | {id} identificador (llave primaria en la BD) | /atributo = derivado (columna calculada) | &lt;i&gt;cursiva&lt;/i&gt; = abstracto | rombo relleno = composición | rombo vacío = agregación | triángulo vacío = herencia | flecha abierta = navegabilidad&lt;br&gt;Cardinalidad: 1 = uno | 0..1 = cero o uno | 0..* = cero o muchos | 1..* = uno o muchos | Patrón Strategy: Usuario delega sus permisos en su Rol (composición sobre herencia); cambiar de rol = cambiar usuarios.id_rol" style="text;html=1;align=left;verticalAlign=top;fontSize=12;fontColor=#000000;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="1560" width="2120" height="80" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>