# Copia este archivo como .env y llena tus datos. El .env NO se sube a git.

# Servidor
PORT=3000
FRONTEND_URL=http://localhost:5173

# Base de datos controlstore_sena (MySQL 8.4)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=escribe_aqui_tu_contrasena
DB_NAME=controlstore_sena

# JWT: clave larga y secreta (solo la conoce el servidor) y duración de la sesión
JWT_SECRET=cambia_esta_clave_por_una_frase_larga_y_secreta
JWT_EXPIRES_IN=8h
